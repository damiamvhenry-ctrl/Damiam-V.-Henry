@import "tailwindcss";

:root {
  --ink: #1d2a27;
  --ink-soft: #3b4a46;
  --muted: #5f6a66;
  --paper: #f7f3ee;
  --paper-alt: #efe7df;
  --cream: #f0e9e0;
  --sage: #c6d3bf;
  --sage-deep: #9db29d;
  --deep: #213d37;
  --deep-strong: #102a28;
  --line: rgba(29, 42, 39, 0.14);
  --shadow: rgba(17, 28, 26, 0.12);
  --serif: "Cormorant Garamond", Georgia, serif;
  --sans: "Manrope", "Segoe UI", sans-serif;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  margin: 0;
  background:
    radial-gradient(circle at top left, rgba(198, 211, 191, 0.35), transparent 28%),
    linear-gradient(180deg, #f9f5f1 0%, var(--paper) 42%, #f4efe9 100%);
  color: var(--ink);
  font-family: var(--sans);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.container {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 30;
  background: rgba(247, 243, 238, 0.88);
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(14px);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 74px;
}

.brand {
  font-family: var(--serif);
  font-size: 1.25rem;
  letter-spacing: 0.04em;
  font-weight: 700;
  color: var(--ink);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 28px;
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 20px;
  border: 1px solid var(--deep);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  cursor: pointer;
  transition: transform 0.2s ease, background 0.2s ease;
}

.button-primary { background: var(--deep); color: var(--paper); }
.button-secondary { background: transparent; color: var(--deep); }
.button-light { background: transparent; color: var(--paper); border-color: rgba(198, 211, 191, 0.8); }

.social-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  background: rgba(247, 243, 238, 0.85);
  border: 1px solid var(--line);
  color: var(--deep);
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border-radius: 4px;
  text-decoration: none;
  transition: all 0.2s ease;
}
.social-pill:hover {
  background: var(--deep);
  color: var(--paper);
  transform: translateY(-2px);
}
